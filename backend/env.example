# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,ehokimiyat.uz,www.ehokimiyat.uz,api.ehokimiyat.uz

# Database Settings
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ehokimiyat
# yoki
USE_POSTGRES=True
DB_NAME=ehokimiyat
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis Settings
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# CORS Settings
CORS_ALLOWED_ORIGINS=https://ehokimiyat.uz,https://api.ehokimiyat.uz,http://localhost:3000,http://localhost:5173

# ==============================================================================
# AI SOZLAMALARI
# ==============================================================================

# AI Provider: 'openai' yoki 'anthropic'
AI_PROVIDER=openai

# AI API Key
AI_API_KEY=your-openai-api-key

# AI Model
AI_MODEL=gpt-4o-mini

# Whisper transkripsiya uchun til
AI_TRANSCRIPTION_LANGUAGE=auto

# ==============================================================================
# TELEGRAM BOT SOZLAMALARI
# ==============================================================================

# Telegram bot token
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ==============================================================================
# BOSHQA SOZLAMALAR
# ==============================================================================

# Development uchun ruxsat berish
ALLOW_DEV_LOGIN=True
